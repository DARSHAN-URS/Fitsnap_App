require 'base64'
require 'fileutils'

default_platform(:ios)

platform :ios do
  desc "Build and upload production release to App Store Connect / TestFlight"
  lane :release do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    raw_key = ENV["APP_STORE_CONNECT_API_KEY"].to_s.strip

    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")

    # If the key file wasn't written yet, normalize and write it now
    if !File.exist?(key_path) || File.read(key_path).strip.empty?
      formatted = raw_key
      begin
        decoded = Base64.decode64(raw_key)
        formatted = decoded if decoded.include?("BEGIN")
      rescue => _
      end
      formatted = formatted.gsub('\n', "\n").strip + "\n"
      File.write(key_path, formatted)
      File.chmod(0600, key_path)
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "temp_keychain_pass_123"

    begin
      delete_keychain(name: keychain_name)
    rescue => _
    end

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    db_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    ctx_path = lane_context[SharedValues::KEYCHAIN_PATH]

    actual_keychain_path = if File.exist?(db_path)
      db_path
    elsif File.exist?(raw_path)
      raw_path
    elsif ctx_path && File.exist?(File.expand_path(ctx_path))
      File.expand_path(ctx_path)
    else
      db_path
    end

    UI.message("Using verified keychain path: #{actual_keychain_path}")

    # If the 2-certificate limit is reached on Apple's portal, revoke the oldest orphaned cert to free up a slot
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      UI.message("Found #{dist_certs.count} distribution certificates on Apple Developer account.")
      if dist_certs.count >= 2
        orphaned = dist_certs.first
        UI.important("Freeing up distribution certificate slot: revoking orphaned certificate #{orphaned.id} (#{orphaned.name})...")
        orphaned.delete!
        UI.success("Successfully revoked #{orphaned.id}. A slot is now open for code signing!")
      end
    rescue => e
      UI.important("Certificate cleanup notice: #{e.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: actual_keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.sabtrack.ai"
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = nil
    if profile_path && File.exist?(profile_path)
      plist_xml = `security cms -D -i "#{profile_path}" 2>/dev/null`
      match = plist_xml.match(/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([A-Z0-9]+)<\/string>/m)
      team_id = match[1] if match
      if !team_id
        content = File.read(profile_path, :encoding => 'BINARY')
        match = content.match(/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([A-Z0-9]+)<\/string>/m)
        team_id = match[1] if match
      end
    end

    UI.message("Detected Apple Team ID: #{team_id}")

    if team_id
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        team_id: team_id,
        bundle_identifier: "com.sabtrack.ai",
        profile_name: lane_context[SharedValues::SIGH_NAME],
        code_sign_identity: "Apple Distribution"
      )
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "SabTrack-Production.ipa",
      xcargs: team_id ? "DEVELOPMENT_TEAM=#{team_id}" : nil
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "../build/ios/ipa/SabTrack-Production.ipa"
    )
  end
end
